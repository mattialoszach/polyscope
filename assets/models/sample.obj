# A simple cube with explicit per-face normals.
# This tests the OBJ parser's  v//vn  format and fan-triangulation.
#
# 8 corners, 6 face normals, 12 triangles (2 per face).

# Positions
v -1.0 -1.0 -1.0
v  1.0 -1.0 -1.0
v  1.0  1.0 -1.0
v -1.0  1.0 -1.0
v -1.0 -1.0  1.0
v  1.0 -1.0  1.0
v  1.0  1.0  1.0
v -1.0  1.0  1.0

# Normals (one per face)
vn  0.0  0.0 -1.0
vn  0.0  0.0  1.0
vn -1.0  0.0  0.0
vn  1.0  0.0  0.0
vn  0.0 -1.0  0.0
vn  0.0  1.0  0.0

# Faces  (v//vn, two triangles per face)
# Front  (-Z)
f 1//1 2//1 3//1
f 1//1 3//1 4//1
# Back   (+Z)
f 6//2 5//2 8//2
f 6//2 8//2 7//2
# Left   (-X)
f 5//3 1//3 4//3
f 5//3 4//3 8//3
# Right  (+X)
f 2//4 6//4 7//4
f 2//4 7//4 3//4
# Bottom (-Y)
f 5//5 6//5 2//5
f 5//5 2//5 1//5
# Top    (+Y)
f 4//6 3//6 7//6
f 4//6 7//6 8//6
